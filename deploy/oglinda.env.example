# Copy to /etc/oglinda.env and adjust.
LG_LISTEN=127.0.0.1:8090
LG_TRUSTED_PROXY=127.0.0.1,::1

LG_BRAND=Example Hosting
LG_BRAND_URL=https://example.com
LG_LOCATION=Frankfurt, Germany
LG_DATACENTER=
LG_IPV4=203.0.113.10
LG_IPV6=

# Hide hops with private/reserved addresses in traceroute output.
LG_MASK_INTERNAL=true
# Extra prefixes visitors may not target (your own customers, management nets).
LG_BLOCK=

LG_PER_MINUTE=6
LG_MAX_JOBS=4
LG_SPEED_MAX_MB=100
LG_SPEED_JOBS=8
# The browser test splits each transfer across this many parallel requests.
LG_SPEED_STREAMS=4
# Speed test traffic budgets, MiB: per client per hour, all clients per minute.
# One full test at LG_SPEED_MAX_MB=100 uses up to about 214 MiB.
LG_SPEED_CLIENT_MB=500
LG_SPEED_TOTAL_MB=1000

# Latency to this server from other cities, measured by Globalping
# (https://globalping.io) and cached. Empty disables it. Each entry is
# "Label=magic", where magic is a Globalping location filter; +eyeball-network
# prefers residential networks. Each run costs 3 tests per location.
LG_WORLD_LOCATIONS=Frankfurt=Frankfurt+eyeball-network;London=London+eyeball-network;New York=New York+eyeball-network
# Address the probes ping; defaults to LG_IPV4.
LG_WORLD_TARGET=
# How often to re-measure; at least 30m.
LG_WORLD_INTERVAL=3h
# Optional free Globalping token for a higher hourly quota.
LG_GLOBALPING_TOKEN=
